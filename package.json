{
    "name": "qcobjects-admin",
    "private": true,
    "version": "1.0.0",
    "description": "With this panel, you can manage settings, configurations and install plugins",
    "main": "public/js/index.cjs",
    "module": "public/js/index.mjs",
    "type": "commonjs",
    "types": "src/types.d.ts",
    "exports": {
        ".": {
            "require": "./public/js/index.cjs",
            "import": "./public/js/index.mjs"
        },
        "./public/js/routes/index.cjs": "./public/js/routes/index.cjs",
        "./routes": "./public/js/routes/index.cjs",
        "./plugins": "./public/js/plugins/index.cjs",
        "./plugins/i": "./public/js/plugins/i/index.cjs",
        "./plugins/u": "./public/js/plugins/u/index.cjs",
        "./handlers": "./public/js/handlers/index.cjs",
        "./cmdshell": "./public/js/cmdshell/index.cjs",
        "./libs": "./public/js/libs/index.cjs",
        "./full-version": "./public/js/version/index.cjs",
        "./client_config": "./public/js/client_config/index.cjs",
        "./client_user": "./public/js/client_user/index.cjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "npm run lint",
        "lint": "(npx eslint \"src/**/*.ts\" --fix --ext ts)",
        "sync": "git add . && git commit -am ",
        "preversion": "npm i --upgrade && npm test",
        "postversion": "git push && git push --tags",
        "v-patch": "qcobjects v-patch",
        "v-minor": "qcobjects v-minor",
        "v-major": "qcobjects v-major",
        "qcobjects": "qcobjects",
        "cli": "qcobjects",
        "build:static": "npx qcobjects-cli publish:static src/ build/ --exclude js --exclude=.DS_Store",
        "build:ts": "npm test && npx tsc",
        "build:ts-types": "npx tsc --project tsconfig.d.json",
        "build": "npm run build:ts-types && npm run build:ts && npm run build:static && npm run publish:static && npm run publish:esbuild && npm run minify:css",
        "publish:static": "(npx qcobjects-cli publish:static build/ public/ --exclude=.DS_Store)",
        "publish:esbuild": "npx esbuild@0.17.19 build/static/js/*.js build/static/js/**/*.js --bundle --outdir=public/static/js --keep-names --minify --global-name=global --sourcemap --splitting --chunk-names=chunks/[name]-[hash] --format=esm --target=es2021",
        "minify:css": "(npx esbuild@0.17.19 build/static/assets/css/*.css build/static/assets/css/**/*.css --outdir=public/static/assets/css --keep-names --minify --global-name=global --sourcemap --loader:.svg=file --target=es2021)",
        "prepare": "node -e \"if(!require('fs').existsSync('.git')){process.exit(0)}\" || npx -y husky install",
        "prestart": "npm run publish:web",
        "cli:help": "qcobjects --help",
        "tree": "tree -d --gitignore"
    },
    "repository": {},
    "keywords": [
        "qcobjects-handler",
        "qcobjects-api",
        "qcobjects",
        "js",
        "javascript"
    ],
    "author": "Jean Machuca (correojean@gmail.com)",
    "license": "LGPL-3.0-or-later",
    "devDependencies": {
        "@types/qcobjects": "github:QCObjects/-types-qcobjects",
        "@types/qcobjects-api": "github:QCObjects/-types-qcobjects-api",
        "@types/qcobjects-sdk": "github:QCObjects/-types-qcobjects-sdk",
        "@typescript-eslint/eslint-plugin": "^5.59.0",
        "@typescript-eslint/parser": "^5.58.0",
        "eslint": "^8.39.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-config-qcobjects": "^0.0.26",
        "eslint-config-qcobjects-typescript": "^2.4.5",
        "eslint-config-semistandard": "^17.0.0",
        "eslint-config-standard": "^17.0.0",
        "eslint-config-standard-with-typescript": "^34.0.1",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-n": "^15.7.0",
        "eslint-plugin-promise": "^6.1.1",
        "hint": "^2.0.0",
        "husky": "^8.0.3",
        "lint-staged": "^13.2.1",
        "npm-run-all": "^4.1.5",
        "qcobjects": "^2.4.95",
        "qcobjects-cli": "^2.4.59",
        "qcobjects-command-publish-static": "^1.0.2",
        "qcobjects-sdk": "^2.4.64",
        "qcobjects-tsconfig": "^2.4.10",
        "semistandard": "^16.0.1",
        "typescript": "^5.0.4"
    },
    "peerDependencies": {
        "qcobjects": "^2.4.95",
        "qcobjects-sdk": "^2.4.64"
    },
    "dependencies": {
        "@pwabuilder/pwaauth": "^0.9.7",
        "qcobjects-admin-lib-db-sqlite3": "file:../qcobjects-admin-lib-db-sqlite3",
        "xterm": "^5.1.0-beta.90"
    },
    "engines": {
        "npm": ">=8",
        "node": ">=16"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
